{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "inh-crabcraft-rooms",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "CrabRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CrabRoom"] }],
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 0.1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
